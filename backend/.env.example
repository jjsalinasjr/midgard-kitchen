# LiveKit (from your LiveKit Cloud project)
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice pipeline providers — direct plugins (design-plan D10)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Supabase / pgvector — RAG store (Step 3)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# --- Optional overrides: the "configurable" pipeline (design-plan D14) ---
# Every provider/model choice is env-driven; uncomment to swap without code edits.
# AGENT_NAME=midgard-kitchen
# STT_MODEL=nova-3
# STT_LANGUAGE=en
# LLM_MODEL=gpt-4o-mini
TTS_MODEL=sonic-3
TTS_SPEED=1.1
TTS_EMOTION=excited
TTS_VOLUME=1.1
TTS_VOICE=
# TURN_DETECTOR_VERSION=      # blank = auto (v1 on Cloud); set v1-mini to force local
